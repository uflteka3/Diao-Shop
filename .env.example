# Diao Shop — Variables d'environnement
# Copier ce fichier vers .env.local puis compléter.

# Fournisseur de données :
#   "mock"     = démonstration, persistance dans .data/db.json (survit au redémarrage)
#   "supabase" = production (9 tables + Storage — voir supabase/schema.sql)
DATA_PROVIDER=mock

# URL publique du site (SEO, metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Connexion administrateur en mode démonstration (mock).
# En mode supabase : Supabase Auth + table public.profiles (rôle admin/staff).
ADMIN_EMAIL=admin@diaoshop.demo
ADMIN_PASSWORD=change-moi
ADMIN_SESSION_SECRET=chaine-aleatoire-longue

# --- Supabase (brancher DATA_PROVIDER=supabase) ---
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=   # SERVEUR UNIQUEMENT — ne jamais préfixer NEXT_PUBLIC_
# SUPABASE_ANON_KEY=           # facultative (le site ne l'utilise pas côté client)
# SUPABASE_DB_PASSWORD=        # facultative (application automatique du schéma)
